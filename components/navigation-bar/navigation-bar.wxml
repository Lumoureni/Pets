<view class="weui-navigation-bar {{extClass}}">
  <view class="weui-navigation-bar__inner {{ios ? 'ios' : 'android'}}" style="color: {{color}}; background: {{background}}; {{displayStyle}}; {{barStyle}};">
    <view class="weui-navigation-bar__content" style="{{contentStyle}}">

      <!-- 左侧：返回 / 首页 / 自定义内容 -->
      <view class="weui-navigation-bar__left">
        <block wx:if="{{back || homeButton}}">
          <view
            wx:if="{{back}}"
            class="weui-navigation-bar__btn weui-navigation-bar__btn_goback_wrapper"
            bindtap="back"
            hover-class="weui-active"
            hover-stay-time="100"
            aria-role="button"
            aria-label="返回"
          >
            <view class="weui-navigation-bar__btn_goback"></view>
          </view>
          <view
            wx:if="{{homeButton}}"
            class="weui-navigation-bar__btn weui-navigation-bar__btn_home_wrapper"
            bindtap="home"
            hover-class="weui-active"
            hover-stay-time="100"
            aria-role="button"
            aria-label="首页"
          >
            <text class="weui-navigation-bar__btn_home">⌂</text>
          </view>
        </block>
        <block wx:else>
          <slot name="left"></slot>
        </block>
      </view>

      <!-- 标题 -->
      <view class="weui-navigation-bar__center">
        <view wx:if="{{loading}}" class="weui-navigation-bar__loading" aria-role="alert">
          <view class="weui-loading" aria-role="img" aria-label="加载中"></view>
        </view>
        <block wx:if="{{title}}">
          <image wx:if="{{logo}}" class="weui-navigation-bar__logo" src="{{logo}}" mode="aspectFit"></image>
          <text class="weui-navigation-bar__title">{{title}}</text>
        </block>
        <block wx:else>
          <slot name="center"></slot>
        </block>
      </view>

      <!-- 右侧：胶囊按钮左侧的自定义内容 -->
      <view class="weui-navigation-bar__right">
        <slot name="right"></slot>
      </view>
    </view>
  </view>
</view>
