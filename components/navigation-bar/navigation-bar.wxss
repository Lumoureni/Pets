.weui-navigation-bar {
  flex: none;
  position: relative;
  z-index: 2;
  color: rgba(0, 0, 0, 0.9);
  background-color: #F4F5F7;
}

.weui-navigation-bar__inner {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  background-color: #F4F5F7;
}

.weui-navigation-bar__inner::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(255, 211, 221, 0.9) 0%, rgba(255, 233, 238, 0.45) 55%, rgba(244, 245, 247, 0) 100%);
  pointer-events: none;
}

.weui-navigation-bar__content {
  position: relative;
  z-index: 1;
  width: 100%;
  padding-left: 16px;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
}

.weui-navigation-bar__left,
.weui-navigation-bar__right {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.weui-navigation-bar__btn {
  width: 32px;
  height: 32px;
  margin-right: 12px;
  border: 2rpx solid rgba(43, 47, 54, 0.85);
  border-radius: 10px;
  background-color: #FFFFFF;
  box-shadow: 2px 2px 0 rgba(43, 47, 54, 0.12);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.weui-navigation-bar__btn.weui-active {
  opacity: 0.55;
}

.weui-navigation-bar__btn_goback {
  width: 9px;
  height: 9px;
  margin-left: 2px;
  border-left: 2px solid #2B2F36;
  border-bottom: 2px solid #2B2F36;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.weui-navigation-bar__btn_home {
  font-size: 20px;
  line-height: 1;
  color: #2B2F36;
}

.weui-navigation-bar__center {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 0.5px;
}

.weui-navigation-bar__logo {
  width: 24px;
  height: 24px;
  margin-right: 8px;
  flex-shrink: 0;
  border-radius: 7px;
  image-rendering: pixelated;
}

.weui-navigation-bar__title {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.weui-navigation-bar__loading {
  margin-right: 8px;
  flex-shrink: 0;
}

.weui-loading {
  width: 16px;
  height: 16px;
  display: block;
  box-sizing: border-box;
  border: 2px solid rgba(43, 47, 54, 0.15);
  border-top-color: #E85A6A;
  border-radius: 50%;
  animation: loading linear infinite 0.8s;
}

@keyframes loading {
  from { transform: rotate(0); }
  to { transform: rotate(360deg); }
}
