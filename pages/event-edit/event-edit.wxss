.chips-card {
  padding: 26rpx 28rpx 10rpx;
}

.block-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #6B7280;
  margin-bottom: 20rpx;
}

.field-picker {
  display: block;
  width: 100%;
}

.note-card {
  padding: 26rpx 28rpx 30rpx;
}

.note-input {
  width: 100%;
  min-height: 130rpx;
  font-size: 27rpx;
  color: #2B2F36;
  line-height: 1.6;
}

.clear-link {
  flex: 1;
  font-size: 25rpx;
  color: #E85A6A;
}

.delete-btn {
  margin-bottom: 18rpx;
}

.type-orbs {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  padding-bottom: 8rpx;
}

.type-orb-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.type-orb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  font-size: 36rpx;
  background: #FFF5F7 !important;
  border: 3rpx solid #2B2F36;
  box-shadow: 3rpx 3rpx 0 rgba(43, 47, 54, 0.1);
}

.type-orb-label {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 10rpx;
}

.type-orb-active .type-orb {
  border-color: #2B2F36;
  background: #FFE8ED !important;
  box-shadow: 4rpx 4rpx 0 rgba(232, 90, 106, 0.45);
  transform: scale(1.04);
}

.type-orb-active .type-orb-label {
  color: #E85A6A;
  font-weight: 600;
}
