<view class="bg-decor">
  <view class="blob blob-a"></view>
  <view class="blob blob-b"></view>
  <view class="blob blob-c"></view>
</view>
<navigation-bar title="{{isEdit ? '编辑事项' : '记录事项'}}" logo="/assets/nav-logo.png" back="{{true}}" color="#2B2F36" background="#F4F5F7"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page-content">
    <view class="form-card chips-card">
      <view class="block-label">事项类型</view>
      <view class="type-orbs">
        <view
          class="type-orb-item {{form.type === item.key ? 'type-orb-active' : ''}}"
          wx:for="{{types}}"
          wx:key="key"
          bindtap="onSelectType"
          data-key="{{item.key}}"
          hover-class="orb-hover"
        >
          <view class="type-orb orb-surface" style="background-color: {{item.bg}}">{{item.icon}}</view>
          <text class="type-orb-label">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="form-card">
      <picker mode="selector" class="field-picker" range="{{petNames}}" value="{{petIndex}}" bindchange="onSelectPet">
        <view class="field">
          <text class="field-label">所属宠物</text>
          <text class="field-value {{petNames.length > 0 ? '' : 'field-placeholder'}}">{{petNames.length > 0 ? petNames[petIndex] : '请先添加宠物'}}</text>
          <text class="field-arrow">›</text>
        </view>
      </picker>
      <view class="field">
        <text class="field-label">事项标题</text>
        <input class="field-input" value="{{form.title}}" data-field="title" bindinput="onInput" placeholder="例如：狂犬疫苗第二针" placeholder-class="field-placeholder" maxlength="30" />
      </view>
      <view class="field" wx:if="{{showAmount}}">
        <text class="field-label">{{valueLabel}}</text>
        <input class="field-input" value="{{form.amount}}" data-field="amount" bindinput="onInput" placeholder="{{valueUnit}}" placeholder-class="field-placeholder" maxlength="30" />
      </view>
      <picker mode="date" class="field-picker" value="{{form.date}}" start="1990-01-01" end="2099-12-31" bindchange="onDateChange">
        <view class="field">
          <text class="field-label">事项日期</text>
          <text class="field-value">{{form.date}}</text>
          <text class="field-arrow">›</text>
        </view>
      </picker>
      <block wx:if="{{showSchedule}}">
        <picker mode="date" class="field-picker" value="{{form.nextDate || today}}" start="{{form.date}}" end="2099-12-31" bindchange="onNextDateChange">
          <view class="field">
            <text class="field-label">下次计划</text>
            <text class="field-value {{form.nextDate ? '' : 'field-placeholder'}}">{{form.nextDate || '选填，例如下一针疫苗'}}</text>
            <text class="field-arrow">›</text>
          </view>
        </picker>
        <view class="field" wx:if="{{form.nextDate}}">
          <text class="field-label"></text>
          <text class="clear-link" bindtap="onClearNext">清除下次计划日期</text>
        </view>
      </block>
      <view class="field field-last">
        <text class="field-label">完成状态</text>
        <switch checked="{{form.done}}" bindchange="onDoneChange" color="#E85A6A" />
      </view>
    </view>

    <view class="form-card note-card">
      <view class="block-label">备注</view>
      <textarea class="note-input" value="{{form.note}}" data-field="note" bindinput="onInput" placeholder="疫苗批号、医院、体重、医生叮嘱……" placeholder-class="field-placeholder" maxlength="200" auto-height></textarea>
    </view>

    <view class="form-hint">喂食、遛弯、体重、消费等日常记录默认视为已完成；疫苗、驱虫、体检等事项填写「下次计划」并标记完成后，会自动生成下一条待办。</view>
  </view>
</scroll-view>

<view class="footer-bar">
  <view wx:if="{{isEdit}}" class="btn btn-danger delete-btn" bindtap="onDelete" hover-class="btn-hover">删除这条事项</view>
  <view class="btn btn-primary" bindtap="onSave" hover-class="btn-hover">保存记录</view>
</view>
