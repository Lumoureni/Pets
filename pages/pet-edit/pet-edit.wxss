.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.avatar-preview-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: center;
  width: 100%;
}

.preview-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.preview-block + .preview-block {
  margin-left: 48rpx;
}

.avatar-preview {
  width: 150rpx;
  height: 150rpx;
  border-radius: 42rpx;
  background-color: #FFE8ED !important;
  border: 4rpx solid #2B2F36 !important;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 6rpx 6rpx 0 rgba(43, 47, 54, 0.1);
}

.pixel-preview {
  background-color: #FFF0D9 !important;
}

.avatar-preview-img {
  width: 150rpx;
  height: 150rpx;
}

.preview-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #6B7280;
}

.avatar-preview-emoji {
  font-size: 88rpx;
}

.avatar-tip {
  font-size: 25rpx;
  color: #9AA0A8;
  margin-top: 22rpx;
}

.avatar-chips {
  justify-content: center;
  margin-top: 24rpx;
  padding: 0 10rpx;
}

.avatar-chip {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background-color: #FFF5F7;
  border: 3rpx solid #2B2F36;
  box-shadow: 3rpx 3rpx 0 rgba(43, 47, 54, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin: 0 12rpx 16rpx;
}

.avatar-chip-active {
  background-color: #FFE8ED;
  box-shadow: 3rpx 3rpx 0 rgba(232, 90, 106, 0.5);
}

.upload-btn {
  margin-top: 12rpx;
  padding: 14rpx 30rpx;
  border-radius: 26rpx;
  background-color: #FFFFFF;
  border: 3rpx solid #2B2F36;
  box-shadow: 3rpx 3rpx 0 rgba(43, 47, 54, 0.12);
  color: #E85A6A;
  font-size: 25rpx;
}

.field-picker {
  display: block;
  width: 100%;
}

.chips-card {
  padding: 26rpx 28rpx 10rpx;
}

.block-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #6B7280;
  margin-bottom: 20rpx;
}

.chips-card .chips {
  margin-bottom: 16rpx;
}

.note-card {
  padding: 26rpx 28rpx 30rpx;
}

.note-input {
  width: 100%;
  min-height: 130rpx;
  font-size: 27rpx;
  color: #2B2F36;
  line-height: 1.6;
}

.delete-btn {
  margin-bottom: 18rpx;
}

.avatar-preview {
  border-radius: 42rpx;
}

.avatar-chip {
  border-radius: 24rpx;
}

.unit-chip {
  font-size: 24rpx;
  color: #9AA0A8;
  padding: 8rpx 14rpx;
  margin-left: 10rpx;
  border-radius: 20rpx;
  border: 2rpx solid #F0F1F3;
}

.unit-chip-active {
  color: #E85A6A;
  border-color: #FFD0D6;
  background: #FFF5F7;
}
