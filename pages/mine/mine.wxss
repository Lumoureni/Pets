.room-card {
  padding: 28rpx 24rpx 22rpx;
  margin-bottom: 24rpx;
  background: #FFFFFF;
}

.room-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 22rpx;
}

.profile-avatar-box {
  width: 110rpx;
  height: 110rpx;
  border-radius: 28rpx;
  overflow: hidden;
  border: 4rpx solid #2B2F36;
  box-shadow: 6rpx 6rpx 0 rgba(43, 47, 54, 0.12);
  flex-shrink: 0;
  background: #FFE8ED;
}

.profile-avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.profile-info {
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #2B2F36;
}

.profile-desc {
  font-size: 26rpx;
  color: #9AA0A8;
  margin-top: 10rpx;
}

.room-scene {
  position: relative;
  height: 300rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #FDEBF0 0%, #FBD8E2 100%);
  border: 3rpx solid #2B2F36;
}

.room-window {
  position: absolute;
  top: 24rpx;
  left: 28rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 18rpx;
  background: #FFF7D6;
  border: 3rpx solid #2B2F36;
  box-shadow: 4rpx 4rpx 0 rgba(43, 47, 54, 0.12);
}

.room-rug {
  position: absolute;
  left: 12%;
  right: 12%;
  bottom: 28rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: #F4B8C8;
  border: 3rpx solid #EFA8BB;
}

.room-pet {
  position: absolute;
  bottom: 44rpx;
  width: 120rpx;
  height: 120rpx;
  background-repeat: no-repeat;
  background-size: 1560rpx 120rpx;
  transition: left 0.5s linear, bottom 0.4s ease, transform 0.4s ease;
}

.room-pet.nap {
  bottom: 36rpx;
}

.room-pet.sleep {
  bottom: 24rpx;
  transform: scaleY(0.82);
}

.room-zzz {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #8A3E52;
  text-shadow: 2rpx 2rpx 0 #FFFFFF;
}

.room-empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #8A3E52;
}

.room-caption {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9AA0A8;
}

.stats {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx 12rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #E85A6A;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #9AA0A8;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: #F0F1F3;
}

.menu {
  padding: 8rpx 8rpx;
  margin-bottom: 28rpx;
}

.menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 2rpx solid #F5F6F7;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-hover {
  background: #FFF5F7;
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #FFF5F7;
  border: 3rpx solid #2B2F36;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  box-shadow: 3rpx 3rpx 0 rgba(43, 47, 54, 0.1);
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #2B2F36;
  font-weight: 500;
}

.menu-arrow {
  font-size: 40rpx;
  color: #C5C9CF;
  margin-left: 12rpx;
}

.quick-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.quick-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 28rpx;
  background: #E85A6A;
  border: 3rpx solid #2B2F36;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 4rpx 4rpx 0 rgba(43, 47, 54, 0.15);
}

.quick-btn-ghost {
  background: #FFFFFF;
  color: #E85A6A;
  box-shadow: 4rpx 4rpx 0 rgba(43, 47, 54, 0.12);
}

.quick-btn-ghost .quick-text {
  color: #E85A6A;
}

.quick-hover {
  transform: scale(0.98);
  opacity: 0.9;
}

.quick-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.version {
  text-align: center;
  font-size: 22rpx;
  color: #B0B5BC;
  padding: 8rpx 0 16rpx;
}

.pad-bottom {
  height: 40rpx;
}
