.profile {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF5F7 100%);
}

.profile-avatar-box {
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  overflow: hidden;
  border: 4rpx solid #2B2F36;
  box-shadow: 6rpx 6rpx 0 rgba(43, 47, 54, 0.12);
  flex-shrink: 0;
  background: #FFE8ED;
}

.profile-avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.profile-info {
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #2B2F36;
}

.profile-desc {
  font-size: 26rpx;
  color: #9AA0A8;
  margin-top: 10rpx;
}

.stats {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx 12rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #E85A6A;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #9AA0A8;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: #F0F1F3;
}

.menu {
  padding: 8rpx 8rpx;
  margin-bottom: 28rpx;
}

.menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 2rpx solid #F5F6F7;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-hover {
  background: #FFF5F7;
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #FFF5F7;
  border: 3rpx solid #2B2F36;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  box-shadow: 3rpx 3rpx 0 rgba(43, 47, 54, 0.1);
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #2B2F36;
  font-weight: 500;
}

.menu-arrow {
  font-size: 40rpx;
  color: #C5C9CF;
  margin-left: 12rpx;
}

.quick-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.quick-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 28rpx;
  background: #E85A6A;
  border: 3rpx solid #2B2F36;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 4rpx 4rpx 0 rgba(43, 47, 54, 0.15);
}

.quick-btn-ghost {
  background: #FFFFFF;
  color: #E85A6A;
  box-shadow: 4rpx 4rpx 0 rgba(43, 47, 54, 0.12);
}

.quick-btn-ghost .quick-text {
  color: #E85A6A;
}

.quick-hover {
  transform: scale(0.98);
  opacity: 0.9;
}

.quick-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.version {
  text-align: center;
  font-size: 22rpx;
  color: #B0B5BC;
  padding: 8rpx 0 16rpx;
}

.pad-bottom {
  height: 40rpx;
}
