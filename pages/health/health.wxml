<view class="bg-decor">
  <view class="blob blob-a"></view>
  <view class="blob blob-b"></view>
  <view class="blob blob-c"></view>
</view>
<navigation-bar title="健康统计" logo="/assets/nav-logo.png" back="{{true}}" color="#2B2F36" background="#F4F5F7"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page-content" wx:if="{{!empty}}">
    <view class="pet-tabs">
      <view
        class="pet-tab {{petId === item.id ? 'pet-tab-active' : ''}}"
        wx:for="{{pets}}"
        wx:key="id"
        bindtap="onSwitchPet"
        data-id="{{item.id}}"
      >{{item.name}}</view>
    </view>

    <view class="stat-grid">
      <view class="stat-card card">
        <text class="stat-label">疫苗完成率</text>
        <text class="stat-value">{{vaccinePercent}}%</text>
        <text class="stat-sub">{{vaccineDone}} / {{vaccineTotal}} 条记录</text>
      </view>
      <view class="stat-card card">
        <text class="stat-label">{{monthLabel}}记录</text>
        <text class="stat-value">{{monthCount}}</text>
        <text class="stat-sub">本月事项总数</text>
      </view>
    </view>

    <view class="progress-track">
      <view class="progress-fill" style="width: {{vaccinePercent}}%"></view>
    </view>

    <view class="section-head">
      <text class="section-title">体重趋势</text>
      <text class="section-sub">最近 {{weightPoints.length}} 次</text>
    </view>
    <view class="chart-card card">
      <block wx:if="{{weightPoints.length > 0}}">
        <view class="chart-bars">
          <view class="chart-col" wx:for="{{weightPoints}}" wx:key="id">
            <text class="chart-value">{{item.value}}</text>
            <view class="chart-bar" style="height: {{item.height}}%"></view>
            <text class="chart-date">{{item.date}}</text>
          </view>
        </view>
      </block>
      <view wx:else class="chart-empty">还没有体重记录，去「记录事项」添加一条吧</view>
    </view>

    <view class="section-head">
      <text class="section-title">记录分布</text>
      <text class="section-sub">按类型</text>
    </view>
    <view class="breakdown-card card">
      <view class="breakdown-item" wx:for="{{breakdown}}" wx:key="key">
        <view class="breakdown-dot" style="background: {{item.color}}"></view>
        <text class="breakdown-name">{{item.icon}} {{item.name}}</text>
        <text class="breakdown-count">{{item.count}} 条</text>
      </view>
      <view wx:if="{{breakdown.length === 0}}" class="chart-empty">暂无记录</view>
    </view>

    <view class="section-head">
      <text class="section-title">最近记录</text>
      <text class="section-sub">点开可编辑</text>
    </view>
    <view
      class="recent-card card"
      wx:for="{{recent}}"
      wx:key="id"
      bindtap="onOpenEvent"
      data-id="{{item.id}}"
      hover-class="card-hover"
    >
      <view class="recent-icon" style="background: {{item.typeBg}}">{{item.typeIcon}}</view>
      <view class="recent-main">
        <text class="recent-title">{{item.title}}</text>
        <text class="recent-meta">{{item.fullDateText}} · {{item.typeName}}<block wx:if="{{item.amountText}}"> · {{item.amountText}}</block></text>
      </view>
      <text class="recent-arrow">›</text>
    </view>
  </view>

  <view wx:else class="empty-state empty-wrap">
    <view class="empty-icon">📊</view>
    <text class="empty-title">还没有宠物档案</text>
    <text class="empty-desc">添加毛孩子后就能看到健康统计啦</text>
    <view class="btn btn-primary empty-btn" bindtap="onAddPet">添加宠物</view>
  </view>
</scroll-view>
