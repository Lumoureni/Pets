.pet-tabs {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.pet-tab {
  padding: 14rpx 30rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 3rpx solid #2B2F36;
  box-shadow: 3rpx 3rpx 0 rgba(43, 47, 54, 0.1);
  color: #6B7280;
  font-size: 27rpx;
}

.pet-tab-active {
  background: #FFE8ED;
  box-shadow: 3rpx 3rpx 0 rgba(232, 90, 106, 0.45);
  color: #E85A6A;
  font-weight: 600;
}

.stat-grid {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 30rpx 26rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #9AA0A8;
}

.stat-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #E85A6A;
  line-height: 1.2;
  margin: 12rpx 0 6rpx;
}

.stat-sub {
  font-size: 22rpx;
  color: #9AA0A8;
}

.progress-track {
  height: 18rpx;
  background: #F0F1F3;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 36rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #FF8A9A 0%, #E85A6A 100%);
  border-radius: 10rpx;
}

.chart-card,
.breakdown-card {
  padding: 30rpx 26rpx;
  margin-bottom: 28rpx;
}

.chart-bars {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  height: 300rpx;
}

.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.chart-value {
  font-size: 21rpx;
  color: #6B7280;
  margin-bottom: 10rpx;
}

.chart-bar {
  width: 42rpx;
  border-radius: 12rpx 12rpx 0 0;
  background: linear-gradient(180deg, #FF8A9A 0%, #E85A6A 100%);
}

.chart-date {
  font-size: 20rpx;
  color: #9AA0A8;
  margin-top: 12rpx;
}

.chart-empty {
  padding: 50rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: #9AA0A8;
}

.breakdown-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 4rpx;
  border-bottom: 2rpx solid #F6F7F8;
}

.breakdown-item:last-child {
  border-bottom: none;
}

.breakdown-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.breakdown-name {
  flex: 1;
  font-size: 27rpx;
  color: #2B2F36;
}

.breakdown-count {
  font-size: 24rpx;
  color: #9AA0A8;
}

.recent-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.recent-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 20rpx;
}

.recent-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.recent-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2B2F36;
}

.recent-meta {
  font-size: 23rpx;
  color: #9AA0A8;
  margin-top: 8rpx;
}

.recent-arrow {
  font-size: 40rpx;
  color: #C5C9CF;
  margin-left: 12rpx;
}

.empty-wrap {
  margin: 80rpx 28rpx;
}

.empty-btn {
  margin-top: 30rpx;
  width: 360rpx;
}
