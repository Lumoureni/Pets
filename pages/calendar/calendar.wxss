.calendar-card {
  padding: 28rpx 20rpx 24rpx;
  margin-bottom: 32rpx;
}

.month-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.month-arrow {
  width: 72rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #E85A6A;
}

.month-title {
  min-width: 240rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #2B2F36;
}

.weekday-row,
.week-row {
  display: flex;
  flex-direction: row;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 23rpx;
  color: #9AA0A8;
  padding-bottom: 12rpx;
}

.day-cell {
  flex: 1;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.day-number {
  font-size: 27rpx;
  color: #2B2F36;
}

.day-muted .day-number {
  color: #C5C9CF;
}

.day-today .day-number {
  color: #E85A6A;
  font-weight: 700;
}

.day-selected {
  background: #FFE8ED;
  border-radius: 20rpx;
  border: 3rpx solid #2B2F36;
}

.day-dot {
  position: absolute;
  bottom: 12rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background: #E85A6A;
}

.day-event {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.day-event-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 20rpx;
}

.day-event-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.day-event-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2B2F36;
}

.day-event-meta {
  font-size: 23rpx;
  color: #9AA0A8;
  margin-top: 8rpx;
}

.day-event-arrow {
  font-size: 40rpx;
  color: #C5C9CF;
  margin-left: 12rpx;
}

.day-empty {
  margin-top: 40rpx;
}
