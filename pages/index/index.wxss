.banner {
  width: 100%;
  height: 324rpx;
  overflow: hidden;
  padding: 0;
  margin-bottom: 24rpx;
  background: #F7BED0;
  border: 3rpx solid #2B2F36;
  box-shadow: 4rpx 4rpx 0 rgba(43, 47, 54, 0.1);
  position: relative;
}

.banner-hover {
  transform: scale(0.995);
}

.banner-add {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  z-index: 3;
  padding: 10rpx 20rpx;
  border-radius: 22rpx;
  background: #FFF7F9;
  border: 3rpx solid #2B2F36;
  box-shadow: 3rpx 3rpx 0 rgba(43, 47, 54, 0.14);
  color: #E85A6A;
  font-size: 22rpx;
  font-weight: 600;
}

.banner-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.banner-pets {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-around;
  padding-bottom: 80rpx;
}

.banner-pet {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.banner-pet-hover {
  transform: scale(0.94);
}

.banner-pet-img {
  width: 160rpx;
  height: 160rpx;
  display: block;
}

.banner-pet-name {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-top: 8rpx;
  max-width: 150rpx;
  padding: 2rpx 14rpx;
  border: 2rpx solid #EFA8BB;
  border-radius: 20rpx;
  background: #FFF7F9;
  color: #8A3E52;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.banner-empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.banner-empty-title {
  color: #8A3E52;
  font-size: 30rpx;
  font-weight: 700;
}

.banner-empty-desc {
  margin-top: 10rpx;
  color: #B46A7E;
  font-size: 24rpx;
}

.feature-card {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 24rpx 12rpx 16rpx;
  margin-bottom: 24rpx;
}

.feature-head {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 20rpx 12rpx;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2B2F36;
}

.feature-sub {
  font-size: 22rpx;
  color: #9AA0A8;
}

.feature-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0 20rpx;
}

.feature-hover {
  transform: scale(0.96);
}

.feature-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 26rpx;
  background: #FFF5F7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  border: 3rpx solid #2B2F36;
  box-shadow: 4rpx 4rpx 0 rgba(43, 47, 54, 0.12);
}

.feature-icon {
  width: 64rpx;
  height: 64rpx;
}

.feature-label {
  font-size: 28rpx;
  color: #2B2F36;
  font-weight: 500;
}

.owner-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
}

.owner-avatar-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #FFE8ED;
  border: 3rpx solid #2B2F36;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 3rpx 3rpx 0 rgba(43, 47, 54, 0.12);
  flex-shrink: 0;
}

.owner-avatar {
  width: 56rpx;
  height: 56rpx;
}

.owner-meta {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-left: 20rpx;
  overflow: hidden;
}

.owner-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #2B2F36;
  white-space: nowrap;
}

.owner-desc {
  font-size: 24rpx;
  color: #9AA0A8;
  margin-left: 6rpx;
  white-space: nowrap;
}

.owner-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #E85A6A;
  background: #FFF0F3;
  border: 2rpx solid #FFD0D6;
  padding: 6rpx 16rpx;
  border-radius: 22rpx;
  margin-left: 16rpx;
}

.section-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 8rpx 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2B2F36;
}

.section-sub {
  font-size: 24rpx;
  color: #9AA0A8;
}

.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.reminder-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 26rpx 24rpx;
}

.card-hover {
  transform: scale(0.99);
}

.reminder-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: #E85A6A;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.reminder-dot.overdue {
  background: #E85A6A;
}

.reminder-dot.today,
.reminder-dot.soon {
  background: #F0A030;
}

.reminder-dot.normal,
.reminder-dot.muted {
  background: #9AA0A8;
}

.reminder-dot.done {
  background: #3DBE9A;
}

.reminder-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.reminder-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2B2F36;
}

.reminder-detail {
  font-size: 24rpx;
  color: #9AA0A8;
  margin-top: 6rpx;
}

.reminder-arrow {
  font-size: 40rpx;
  color: #C5C9CF;
  margin-left: 12rpx;
}

.pad-bottom {
  height: 40rpx;
}

.task-card {
  padding: 22rpx 22rpx 12rpx;
  margin-bottom: 24rpx;
}

.task-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #F2F3F5;
}

.task-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2B2F36;
}

.calendar-link {
  font-size: 23rpx;
  color: #E85A6A;
  padding: 8rpx 10rpx;
}

.task-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 4rpx;
  border-bottom: 2rpx solid #F6F7F8;
}

.task-row:last-child {
  border-bottom: none;
}

.task-empty {
  padding: 34rpx 0 26rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9AA0A8;
}

.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(43, 47, 54, 0.45);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-card {
  width: 620rpx;
  padding: 36rpx 32rpx 28rpx;
}

.modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2B2F36;
  margin-bottom: 20rpx;
}

.modal-field {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 2rpx solid #F2F3F5;
}

.modal-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: #6B7280;
}

.modal-value,
.modal-input {
  flex: 1;
  font-size: 28rpx;
  color: #2B2F36;
}

.modal-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-cancel {
  background: #F4F5F7;
  color: #6B7280;
  border: 3rpx solid #2B2F36;
  box-shadow: 3rpx 3rpx 0 rgba(43, 47, 54, 0.12);
}

.modal-confirm {
  background: #E85A6A;
  color: #FFFFFF;
  border: 3rpx solid #2B2F36;
  box-shadow: 3rpx 3rpx 0 rgba(43, 47, 54, 0.15);
}
