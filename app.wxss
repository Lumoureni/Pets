page {
  min-height: 100vh;
  background-color: #F4F5F7;
  color: #2B2F36;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  line-height: 1.5;
  box-sizing: border-box;
}

view, text, image, scroll-view, button, textarea, input {
  box-sizing: border-box;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F4F5F7;
  overflow: hidden;
}

.page-body {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 20rpx 24rpx 40rpx;
}

.card {
  background-color: #FFFFFF;
  border-radius: 26rpx;
  border: 3rpx solid #2B2F36;
  box-shadow: 4rpx 4rpx 0 rgba(43, 47, 54, 0.12);
}

.card-hover {
  transform: scale(0.99);
}

.section-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 8rpx 14rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2B2F36;
}

.section-sub {
  font-size: 24rpx;
  color: #9AA0A8;
}

.btn {
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
}

.btn-primary {
  background: #E85A6A;
  color: #FFFFFF;
  border: 3rpx solid #2B2F36;
  box-shadow: 4rpx 4rpx 0 rgba(43, 47, 54, 0.15);
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: #FFFFFF;
  color: #E85A6A;
  border: 3rpx solid #2B2F36;
  box-shadow: 4rpx 4rpx 0 rgba(43, 47, 54, 0.12);
}

.btn-ghost::after {
  border: none;
}

.btn-danger {
  background: #FFF0F0;
  color: #D85E58;
  border: 3rpx solid #2B2F36;
  box-shadow: 4rpx 4rpx 0 rgba(43, 47, 54, 0.12);
}

.btn-danger::after {
  border: none;
}

.btn-hover {
  transform: scale(0.985);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  background: #FFFFFF;
  border: 3rpx solid #2B2F36;
  border-radius: 26rpx;
  box-shadow: 4rpx 4rpx 0 rgba(43, 47, 54, 0.12);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2B2F36;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #9AA0A8;
  text-align: center;
  line-height: 1.7;
}

.pixel-img {
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

/* ---- subpage layout ---- */
.scrollarea {
  flex: 1;
  height: 0;
  min-height: 0;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.page-content {
  padding: 20rpx 24rpx 40rpx;
}

.footer-bar {
  flex-shrink: 0;
  height: auto;
  padding: 18rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 2rpx solid #F0F1F3;
  position: relative;
  z-index: 2;
}

.footer-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.footer-btn-small {
  flex: 1;
}

.footer-btn-large {
  flex: 2;
}

/* ---- forms ---- */
.form-card {
  background-color: #FFFFFF;
  border-radius: 26rpx;
  border: 3rpx solid #2B2F36;
  box-shadow: 4rpx 4rpx 0 rgba(43, 47, 54, 0.12);
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
}

.field {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 2rpx solid #F2F3F5;
}

.field-last,
.field-picker:last-child .field {
  border-bottom: none;
}

.field-label {
  width: 170rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #6B7280;
}

.field-input {
  flex: 1;
  font-size: 28rpx;
  color: #2B2F36;
}

.field-value {
  flex: 1;
  font-size: 28rpx;
  color: #2B2F36;
}

.field-placeholder {
  color: #B0B5BC;
}

.field-arrow {
  color: #C5C9CF;
  font-size: 36rpx;
  margin-left: 12rpx;
}

.field-picker {
  display: block;
}

.block-label {
  font-size: 26rpx;
  color: #6B7280;
  padding: 24rpx 4rpx 12rpx;
}

.chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.chip {
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  background-color: #FFF5F7;
  border: 2rpx solid #FFE0E6;
  color: #6B7280;
  font-size: 26rpx;
  margin: 0 16rpx 16rpx 0;
}

.chip-active {
  background-color: #FFE8ED;
  border-color: #E85A6A;
  color: #E85A6A;
  font-weight: 600;
}

.chips-card {
  padding: 8rpx 28rpx 20rpx;
}

.note-card {
  padding: 8rpx 28rpx 28rpx;
}

.note-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #2B2F36;
  line-height: 1.6;
  padding: 8rpx 0;
}

.form-hint {
  font-size: 23rpx;
  color: #9AA0A8;
  line-height: 1.7;
  padding: 0 8rpx 24rpx;
}

.delete-btn {
  margin-bottom: 16rpx;
}

.clear-link {
  font-size: 24rpx;
  color: #E85A6A;
}

/* ---- legacy soft surfaces still used by detail pages ---- */
.orb-surface {
  background-color: #FFF5F7;
  border: 2rpx solid #FFE0E6;
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.orb-shine {
  display: none;
}

.orb-float {
  animation-name: orbFloat;
  animation-duration: 4s;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

@keyframes orbFloat {
  0% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
  100% { transform: translateY(0); }
}

.orb-hover {
  transform: scale(0.96);
}

.bg-decor {
  display: none;
}

.tabs {
  display: flex;
  flex-direction: row;
  background: #FFFFFF;
  border: 3rpx solid #2B2F36;
  border-radius: 40rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 4rpx 4rpx 0 rgba(43, 47, 54, 0.12);
}

.tab {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6B7280;
}

.tab-active {
  background: linear-gradient(135deg, #FF8A9A 0%, #E85A6A 100%);
  color: #FFFFFF;
  font-weight: 600;
}

.tab-count {
  margin-left: 8rpx;
  opacity: 0.9;
}

.event-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 3rpx solid #D0D4DA;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 18rpx;
  color: #FFFFFF;
  font-size: 28rpx;
}

.event-check-done {
  background: #3DBE9A;
  border-color: #3DBE9A;
}
